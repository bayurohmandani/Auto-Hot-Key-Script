$Numpad9:: SetBranch("Gajah", "Repara", "{Numpad9}")

SetBranch(branch, warehouse, fallbackKey) {
    try {
        focus := ControlGetClassNN(ControlGetFocus("A"))
        if (focus = toBranchColumn) {
            SendInput branch "{Tab}" warehouse "{Tab}"
        } else if (focus = toWarehouse) {
            SendInput warehouse "{Tab}"
        } else {
            Send(fallbackKey)
        }
    } catch {
        Send(fallbackKey)
    }
}

; --- AUDITING ---
NumpadIns:: {
    Auditing()
    Sleep 50
    MouseClick("left", 48, 142) 
}
~Enter:: {
    if WinActive(semarProcess) {
        global pieceCount
        pieceCount++
    }
}

Auditing() {
    if !WinExist(SemarClass)
        return

    ControlClick(AuditBtn, SemarClass)
    
    if WinWaitActive("Confirm Message", , 30) {
        Sleep 100
        ControlClick("Button1", "Confirm Message")
        Send("{Space}")
    }
    
    if WinWaitActive(SuccessAuditClass, , 30) {
        Loop 20 { 
            try {
                if (ControlGetText("Static1", semarProcess) = "Audit Bill Success!") {
                    Sleep 50
                    SendInput("{NumpadEnter}")
                    break
                }
            }
            Sleep 100
        }
    }

    try {
        Sleep 300
        if (ControlGetText(Situation, semarProcess) = "Audit") {
            ControlClick(NewBtn, SemarClass)
            Sleep 50
            ControlFocus(ScanColumn, SemarClass)
        } else {
            TrayTip("Not AUDITED yet!`nCheck stock or retry if network is poor.", "System Warning - Bayu Rohmandani", 1)
        }
    }
}

NumpadDel:: {
    TriggerNewAudit()
    Sleep 50
    MouseClick("left", 48, 142) 
}

TriggerNewAudit() {
    try {
        ControlClick(NewBtn, SemarClass)
        Sleep 100
        ControlFocus(ScanColumn, SemarClass)
    }
}

; --- SCANNING & PRINTING ---
End:: {    
    global isPrinted, text1, text2, totalAL, finalResult, finalResult2, pieceCount, readyForPrint
    if !WinExist(SemarClass)
        return

    StartTime := A_TickCount
    MaxTimeout := 500000 

    ControlClick(SaveBtn, SemarClass)
    Loop {
        if GetKeyState("Esc", "P") {
            return
        }
        if (A_TickCount - StartTime > MaxTimeout) {
            TrayTip("5-Minute Timeout: Save Failed.", "Timeout Error - Bayu Rohmandani", 1)
            return
        }

        if WinActive(SuccessAuditClass) {
            try {
                if (ControlGetText("Static1", SuccessAuditClass) = "Save Bill Success!") {
                    readyForPrint := 1
                    Sleep 100
                    SendInput("{NumpadEnter}") 
                    break 
                }
            }
        }
        Sleep(100)
    }
    
    text2 := text1
    finalResult2 := finalResult
    finalResult += pieceCount
    
    if (readyForPrint == 1) {
        Loop {
            if GetKeyState("Esc", "P") || (A_TickCount - StartTime > MaxTimeout)
                return
            try {
                text1 := ControlGetText(ALNumber, SemarClass)
                if (text1 != "" && text1 != "0000000000") {
                    break 
                }
            }
            Sleep(100)
        }

        Loop {
            if GetKeyState("Esc", "P") || (A_TickCount - StartTime > MaxTimeout)
                return
            try {
                if ControlGetEnabled(PrintBtn, SemarClass) {
                    ControlFocus(PrintBtn, SemarClass)
                    ControlClick(PrintBtn, SemarClass)
                    
                    if WinWaitActive("ProgressForm", , 3) {
                        isPrinted := 1
                        break 
                    }
                }
            } catch {
                ; Ignore disabled error
            }
            
            if (Mod(A_Index, 20) == 0) {
                SendInput("{Enter}")
            }
            Sleep(100)
        }
        
        readyForPrint := 0 
        
        totalAL++
        if (finalResult > 3400) {
            CustomTrayTip("TIME FOR A BREAK", "Slow down! Leave some work for the others!`nCurrent: "  finalResult, 5000)
        }
    }

    if (isPrinted = 1) {
        Loop {
            if (GetKeyState("Esc", "P") || A_TickCount - StartTime > MaxTimeout)
                return

            if !WinExist("ProgressForm") {
                break 
            }

            Sleep(100)
        }
        
        pieceCount := 0
        if WinExist(SemarClass) {
            WinActivate(SemarClass)
            Sleep(300)
            WinWaitActive(SemarClass)
            try {
                ClickNew() 
            } catch {
                Sleep 300
                ClickNew()
            }
        }
    }
    ToolTip(" " finalResult "/" totalAL " | " text1 "<<`n " finalResult2 "/" totalAL-1 " | " text2, 0, 0)
}


CustomTrayTip(title, message, duration := 3000) {
    trayGui := Gui("-Caption +AlwaysOnTop +ToolWindow +Border")
    trayGui.BackColor := "20FFFF"  
    trayGui.SetFont("s11", "Segoe UI bold")
    trayGui.Add("Text", "w250", title)
    trayGui.SetFont("s10", "Segoe UI")
    trayGui.Add("Text", "w250", message)
    
    ; Add Personal Branding to Custom Tray
    trayGui.SetFont("s8 italic", "Segoe UI")
    trayGui.Add("Text", "w250 cBlue", "© Bayu Rohmandani | IG: @bayurohmand")

    MonitorGetWorkArea(1, &Left, &Top, &Right, &Bottom)

    trayGui.Show("Hide")
    trayGui.GetPos(,, &Width, &Height)

    PosX := Right - Width - 15
    PosY := Bottom - Height - 105

    trayGui.Show("NA x" PosX " y" PosY)

    SetTimer(() => trayGui.Destroy(), -duration)
}


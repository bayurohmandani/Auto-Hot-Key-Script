VerifikasiLisensi(ManualCheck := false) {
    static URL := "https://raw.githubusercontent.com/bayurohmandani/Auto-Hot-Key-Script/main/opscanner.json"
    local TmpDir := EnvGet("TEMP") "\SemarAutomation"
    local TmpFile := TmpDir "\license_cache.json"
    local HariIni := FormatTime(, "yyyyMMdd")
    
    if !DirExist(TmpDir)
        DirCreate(TmpDir)

    DownloadBaru := ManualCheck
    if !DownloadBaru && FileExist(TmpFile) {
        if (SubStr(FileGetTime(TmpFile, "M"), 1, 8) != HariIni) 
            DownloadBaru := true
    } else {
        DownloadBaru := true
    }

    if (DownloadBaru) {
        try Download(URL, TmpFile)
        catch {
            if !FileExist(TmpFile) {
                MsgBox("Koneksi internet diperlukan.", "Offline", "Iconx")
                ExitApp()
            }
        }
    }

    try {
        Konten := FileRead(TmpFile)
        if !RegExMatch(Konten, '"enabled":\s*true') {
            MsgBox("Program dinonaktifkan. Hubungi @bayurohmand.", "Ditolak", "Iconx")
            ExitApp()
        }

        if RegExMatch(Konten, '"expiry":\s*"([^"]+)"', &Match) {
            Selisih := DateDiff(StrReplace(Match[1], "-", ""), HariIni, "Days")
            if (Selisih < 0) {
                MsgBox("Lisensi Expired!", "Expired", "Iconx")
                ExitApp()
            }
            if (ManualCheck)
                MsgBox("Status: AKTIF`nExpired: " Match[1] "`nSisa: " Selisih " hari.", "Info", "Iconi")
        }
    }
}

^l:: VerifikasiLisensi(true)

$Numpad4:: hewer("Batang", "{Numpad4}")

hewer(werhos, salah) {
    try {
        fokus := ControlGetClassNN(ControlGetFocus("A"))
        if (fokus = kolomToBranch) {
            SendInput "onli{Tab}" werhos "{Tab}"
        } else if (fokus = toWarehouse) {
            SendInput werhos "{Tab}"
        } else {
            Send(salah)
        }
    } catch {
        Send(salah)
    }
}

; --- AUDITING ---
NumpadIns:: Auditing()

~Enter:: {
    if WinActive(semarProcess) {
        global bijian
        bijian++
    }
}

Auditing() {
    if !WinExist(KelasSemar)
        return

    ControlClick(TombolAudit, KelasSemar)
    
    if WinWaitActive("Confirm Message", , 2) {
        Sleep 100
        ControlClick("Button1", "Confirm Message")
        Send("{Space}")
    }
    
    if WinWaitActive(KelasBerhasilAudit, , 3) {
        Loop 20 { ; Timeout loop agar tidak stuck selamanya
            try {
                if (ControlGetText("Static1", semarProcess) = "Audit Bill Success!") {
                    Sleep 50
                    SendInput("{NumpadEnter}")
                    break
                }
            }
            Sleep 100
        }
    }

    try {
        Sleep 300
        if (ControlGetText(Situasi, semarProcess) = "Audit") {
            ControlClick(TombolNew, KelasSemar)
            Sleep 50
            ControlFocus(KolomScan, KelasSemar)
        } else {
            MsgBox("Belum di AUDIT`nCek stock atau ulangi jika jaringan buruk", "Info", "Icon!")
        }
    }
}

NumpadDel:: newAudit()

newAudit() {
    try {
        ControlClick(TombolNew, KelasSemar)
        Sleep 100
        ControlFocus(KolomScan, KelasSemar)
    }
}

; --- SCANNING & PRINTING ---
End:: {    
    global tercetak, teks, teks2, jumlahAL, hasilAkhir, hasilAkhir2, bijian
    if !WinExist(KelasSemar)
        return

    ControlClick(TombolSave, KelasSemar)
    
    if WinWaitActive(KelasBerhasilAudit, , 3) {
        Loop 20 {
            try {
                if (ControlGetText("Static1", semarProcess) = "Save Bill Success!") {
                    Sleep 50
                    SendInput("{NumpadEnter}")
                    break
                }
            }
            Sleep 100
        }
    }

    teks2 := teks
    hasilAkhir2 := hasilAkhir
    hasilAkhir += bijian
    jumlahAL++
    
    WinWaitActive(KelasSemar, , 2)
    Sleep(350)
    
    try {
        teks := ControlGetText(noAL, KelasSemar)
    }
    
    Sleep(50)
    ControlClick(TombolPrint, KelasSemar)
    
    ToolTip("> " hasilAkhir "/" jumlahAL " | " teks "`n" hasilAkhir2 "/" jumlahAL-1 " | " teks2, 0, 0)
    
    if WinWaitActive("ProgressForm", , 5) {
        tercetak := 1
        Sleep(500)
        bijian := 0
        kliknew()
    }
}

^!V:: SendInput(teks)

Home:: {
    global tercetak
    ControlClick(TombolNew, KelasSemar)
    Sleep(100)
    ControlFocus(kolomToBranch, KelasSemar)
    tercetak := 0
}

Pgdn:: kliknew()

kliknew() {
    global tercetak
    if (tercetak = 1) {
        WinWaitActive(KelasSemar)
        Loop 20 {
            try {
                if (StrLen(ControlGetText(Situasi, semarProcess)) > 2)
                    break
            }
            Sleep 100
        }
        Sleep(200)
        ControlClick(TombolNew, KelasSemar)
        Sleep(100)
        ControlFocus(kolomToBranch, KelasSemar)
        tercetak := 0
    }
}


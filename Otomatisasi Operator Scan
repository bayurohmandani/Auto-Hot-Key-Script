PilihAplikasi(*) {
    global profile
    switch Dropdown.Text {
        case "Win7/r11" : profile := "r11"
        case "Win10/r8" : profile := "r8"
        case "Win10/r7" : profile := "r7"
        case "Win11/r7" : profile := "11r7"
    }
    SetupProfile() ; Inisialisasi variabel berdasarkan pilihan
    GuiA.Destroy()
    
    ; Jalankan verifikasi lisensi setelah pilih profil
    if (profile != "r11")
        VerifikasiLisensi(false)
}


; ==============================================================================
; MANUAL HOTKEY AND SECURE LICENSE VERIFICATION SYSTEM
; ==============================================================================
^l:: VerifyLicense(true)

VerifyLicense(ManualCheck := false) {
    ; Using official GitHub API endpoint to fetch raw file contents
    static URL := "https://api.github.com/repos/bayurohmandani/Auto-Hot-Key-Script/contents/opscanner.json"
    local TmpDir := EnvGet("TEMP") "\SemarAutomation"
    local TmpFile := TmpDir "\license_cache69.json"
    local CurrentDate := FormatTime(, "yyyyMMdd")
    
    if !DirExist(TmpDir)
        DirCreate(TmpDir)

    NewDownload := ManualCheck
    if !NewDownload && FileExist(TmpFile) {
        FileTime := FileGetTime(TmpFile, "M")
        ; Cache set to 60 Minutes to avoid GitHub API limits
        if (DateDiff(A_Now, FileTime, "Minutes") > 60) 
            NewDownload := true
    } else {
        NewDownload := true
    }

    if (NewDownload) {
        try {
            whr := ComObject("WinHttp.WinHttpRequest.5.1")
            whr.Open("GET", URL, true)
            whr.SetRequestHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64)")
            
            ; CRITICAL HEADER: Forces GitHub API to reply with raw JSON text
            whr.SetRequestHeader("Accept", "application/vnd.github.v3.raw")
            
            whr.Send()
            whr.WaitForResponse()
            
            if (whr.Status != 200)
                throw Error("HTTP Status " whr.Status)
            
            FileOpen(TmpFile, "w", "UTF-8").Write(whr.ResponseText)
        }
        catch {
            if !FileExist(TmpFile) {
                TrayTip("Internet connection required for initial verification.`n- Bayu Rohmandani IG: @bayurohmand", "System Offline", 3)
                Sleep 3000
                ExitApp()
            }
        }
    }

    try {
        Content := FileRead(TmpFile, "UTF-8")
        
        ; Protection if cache is corrupted or contains HTML error text
        if (SubStr(LTrim(Content), 1, 1) != "{") {
            FileDelete(TmpFile)
            TrayTip("Failed to process GitHub API license (Blocked/Protected). Please try again later.`n- Bayu Rohmandani IG: @bayurohmand", "API Error", 3)
            Sleep 3000
            ExitApp()
        }

        ; --- READ JSON USING REGEX (No COM Object / htmlfile) ---
        local IsEnabled := false
        local ExpiryDate := "00000000"
        local ExpiredMessage := "License Expired!"
        local RawExpiryText := ""
        
        ; Extract enabled value
        if RegExMatch(Content, '"enabled"\s*:\s*(true|false)', &matchEnabled)
            IsEnabled := (matchEnabled[1] == "true")
            
        ; Extract expiry value
        if RegExMatch(Content, '"expiry"\s*:\s*"([^"]+)"', &matchExpiry) {
            RawExpiryText := matchExpiry[1]
            ExpiryDate := StrReplace(matchExpiry[1], "-", "")
        }
            
        ; Extract message value
        if RegExMatch(Content, '"message"\s*:\s*"([^"]+)"', &matchMessage)
            ExpiredMessage := matchMessage[1]

        ; --- LICENSE VALIDATION ---
        if (!IsEnabled) {
            TrayTip("Program disabled. Please contact admin.`n- Bayu Rohmandani IG: @bayurohmand", "Access Denied", 3)
            Sleep 3000
            ExitApp()
        }

        local Difference := DateDiff(ExpiryDate, CurrentDate, "Days")
        
        if (Difference < 0) {
            TrayTip(ExpiredMessage "`n- Bayu Rohmandani IG: @bayurohmand", "License Expired", 3)
            Sleep 3000
            ExitApp()
        }
        
        if (ManualCheck) {
            TrayTip("Status: ACTIVE`nExpiry: " RawExpiryText "`nRemaining: " Difference " days.`n- Bayu Rohmandani IG: @bayurohmand", "License Valid", 3)
            Sleep 3000
        }
            
    } catch {
        TrayTip("Failed to process local license file. File might be corrupted.`n- Bayu Rohmandani IG: @bayurohmand", "System Error", 3)
        Sleep 3000
        ExitApp()
    }
}
